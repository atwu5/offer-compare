/** 全局样式：铂金白底 + 金色点缀（与 Web 版白金风格一致） */

page {
  background: #f6f5f1;
  color: #1d1b16;
  font-size: 28rpx;
  line-height: 1.6;
}

view,
text,
picker,
input {
  box-sizing: border-box;
}

.num {
  font-family: -apple-system, 'SF Pro Display', 'Helvetica Neue', 'PingFang SC', sans-serif;
  font-variant-numeric: tabular-nums;
}

/* 卡片 */
.card {
  background: #ffffff;
  border: 1rpx solid rgba(28, 25, 18, 0.08);
  border-radius: 24rpx;
  box-shadow: 0 2rpx 6rpx rgba(28, 25, 18, 0.04), 0 12rpx 32rpx rgba(28, 25, 18, 0.05);
}

/* 区块标题 */
.sec-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 40rpx 4rpx 20rpx;
}
.sec-index {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #8c6d1f;
  background: rgba(201, 162, 39, 0.12);
  border: 1rpx solid rgba(201, 162, 39, 0.4);
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}
.sec-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1d1b16;
}
.sec-desc {
  font-size: 24rpx;
  color: #6e6a5e;
  margin: 6rpx 4rpx 0;
}

/* 提示条 */
.alert {
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  line-height: 1.6;
}
.alert-warn {
  background: rgba(201, 162, 39, 0.1);
  border: 1rpx solid rgba(201, 162, 39, 0.35);
  color: #8c6d1f;
}
.alert-error {
  background: rgba(214, 69, 69, 0.08);
  border: 1rpx solid rgba(214, 69, 69, 0.4);
  color: #b42323;
}
.alert-info {
  background: rgba(61, 111, 224, 0.08);
  border: 1rpx solid rgba(61, 111, 224, 0.3);
  color: #2c55a8;
}

/* 徽标 */
.badge {
  display: inline-flex;
  align-items: center;
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
  font-size: 20rpx;
  font-weight: 500;
}
.badge-gold {
  background: rgba(201, 162, 39, 0.14);
  color: #8c6d1f;
  border: 1rpx solid rgba(201, 162, 39, 0.35);
}
.badge-amber {
  background: rgba(183, 121, 31, 0.14);
  color: #8a5a12;
}
.badge-green {
  background: rgba(15, 157, 108, 0.12);
  color: #0b7a54;
}
.badge-red {
  background: rgba(214, 69, 69, 0.12);
  color: #b42323;
}
.badge-slate {
  background: rgba(28, 25, 18, 0.05);
  color: #6e6a5e;
}

/* 按钮 */
.btn {
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 500;
  text-align: center;
  padding: 14rpx 24rpx;
  line-height: 1.4;
}
.btn::after {
  border: none;
}
.btn-gold {
  background: linear-gradient(180deg, #e7ce7b, #c9a227);
  color: #2b210a;
  font-weight: 600;
}
.btn-ghost {
  background: #ffffff;
  border: 1rpx solid rgba(28, 25, 18, 0.14);
  color: #6e6a5e;
}

/* 文本色 */
.pos {
  color: #0f9d6c;
}
.neg {
  color: #d64545;
}
.muted {
  color: #9b968a;
}

/* 表单通用 */
.field-label {
  font-size: 24rpx;
  font-weight: 500;
  color: #4a463c;
  margin-bottom: 8rpx;
}
.field-hint {
  font-size: 20rpx;
  color: #9b968a;
  line-height: 1.5;
  margin-bottom: 8rpx;
}
.input-box {
  display: flex;
  align-items: center;
  background: #fbfaf7;
  border: 1rpx solid rgba(28, 25, 18, 0.12);
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
}
.input-box.input-invalid {
  border-color: rgba(214, 69, 69, 0.55);
}
.input-prefix,
.input-suffix {
  font-size: 24rpx;
  color: #9b968a;
  flex-shrink: 0;
}
.input-prefix {
  margin-right: 8rpx;
}
.input-suffix {
  margin-left: 8rpx;
  white-space: nowrap;
}
.input-core {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #1d1b16;
}
.select-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fbfaf7;
  border: 1rpx solid rgba(28, 25, 18, 0.12);
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
}
.select-value {
  font-size: 26rpx;
  color: #1d1b16;
}
.select-value.select-placeholder {
  color: #9b968a;
}
.select-arrow {
  color: #9b968a;
  font-size: 22rpx;
  margin-left: 12rpx;
}

/* 分段控件 */
.segmented {
  display: inline-flex;
  background: rgba(28, 25, 18, 0.05);
  border: 1rpx solid rgba(28, 25, 18, 0.07);
  border-radius: 12rpx;
  padding: 4rpx;
}
.segmented-item {
  padding: 6rpx 18rpx;
  border-radius: 9rpx;
  font-size: 24rpx;
  color: #6e6a5e;
}
.segmented-item.segmented-active {
  background: rgba(201, 162, 39, 0.16);
  color: #8c6d1f;
  font-weight: 600;
  border: 1rpx solid rgba(201, 162, 39, 0.45);
}

/* 复选与单选行 */
.check-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}
.check-box {
  width: 32rpx;
  height: 32rpx;
  border-radius: 8rpx;
  border: 2rpx solid rgba(28, 25, 18, 0.25);
  background: #ffffff;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 2rpx;
}
.check-box.check-on {
  background: #c9a227;
  border-color: #c9a227;
}
.check-mark {
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
}
.radio-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(28, 25, 18, 0.25);
  background: #ffffff;
  flex-shrink: 0;
  margin-top: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.radio-dot.radio-on {
  border-color: #c9a227;
}
.radio-dot-inner {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #c9a227;
}

/* ==================== 生活计算工具箱（暖白底 + 蓝紫 + 暖橙） ==================== */

.tb-page {
  min-height: 100vh;
  background: #faf9f7;
  padding: 32rpx 24rpx;
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.tb-hero {
  padding: 16rpx 8rpx 28rpx;
}
.tb-title {
  font-size: 44rpx;
  font-weight: 700;
  background: linear-gradient(120deg, #5b4be0, #6d5bf6 45%, #8b5cf6);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.tb-hero-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #6f6b80;
}
.tb-chips {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.tb-chip {
  background: #ffffff;
  border: 1rpx solid #eceaf2;
  border-radius: 999rpx;
  padding: 4rpx 20rpx;
  font-size: 20rpx;
  color: #6f6b80;
}

.tb-card {
  background: #ffffff;
  border: 1rpx solid #eceaf2;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 4rpx rgba(33, 30, 46, 0.04), 0 14rpx 34rpx rgba(96, 80, 190, 0.07);
  box-sizing: border-box;
}
.tb-card-pad {
  padding: 28rpx 24rpx;
}
.tb-entry {
  transition: transform 0.16s ease;
}
.tb-entry:active {
  transform: scale(0.97);
}

.tb-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
}

.tb-btn-primary {
  background: linear-gradient(135deg, #6d5bf6, #8b5cf6);
  color: #ffffff;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  padding: 20rpx 0;
  box-shadow: 0 8rpx 24rpx rgba(109, 91, 246, 0.28);
}
.tb-btn-ghost {
  background: #ffffff;
  border: 1rpx solid #e7e4ef;
  color: #6f6b80;
  border-radius: 20rpx;
  font-size: 26rpx;
  text-align: center;
  padding: 16rpx 24rpx;
}

.tb-label {
  font-size: 24rpx;
  font-weight: 500;
  color: #211e2e;
  margin-bottom: 10rpx;
}
.tb-hint {
  font-size: 20rpx;
  color: #a5a1b3;
  line-height: 1.55;
  margin-bottom: 10rpx;
}
.tb-input {
  display: flex;
  align-items: center;
  width: 100%;
  min-width: 0;
  height: 88rpx;
  border-radius: 16rpx;
  border: 1rpx solid #e4e1ee;
  background: #fbfaff;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #211e2e;
  box-sizing: border-box;
}

/* 原生 input 统一用「外层 .tb-field 套壳 + 内层 .tb-field-input 撑满」写法：
   抖音原生 input 不生效 box-sizing，直接 width:100% + padding 会横向溢出、
   垂直方向也不按 padding 居中（2026-11-11 真机反馈的错位问题） */
.tb-field {
  display: flex;
  align-items: center;
  width: 100%;
  height: 88rpx;
  border-radius: 16rpx;
  border: 1rpx solid #e4e1ee;
  background: #fbfaff;
  padding: 0 20rpx;
  box-sizing: border-box;
}
.tb-field-input {
  flex: 1;
  width: 100%;
  height: 100%;
  min-width: 0;
  font-size: 28rpx;
  color: #211e2e;
  background: transparent;
}
.tb-field-invalid {
  border-color: #e05252;
}
.tb-placeholder {
  color: #b3afc2;
}

.tb-seg {
  display: inline-flex;
  flex-wrap: wrap;
  gap: 4rpx;
  background: #f3f1fa;
  border: 1rpx solid #eceaf2;
  border-radius: 18rpx;
  padding: 6rpx;
}
.tb-seg-item {
  padding: 10rpx 24rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
  color: #6f6b80;
}
.tb-seg-item.tb-seg-active {
  background: #ffffff;
  color: #6d5bf6;
  font-weight: 600;
  border: 1rpx solid #d8d2f5;
}

.tb-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  border: 3rpx solid #cfcbdd;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.tb-check.tb-check-on {
  background: #6d5bf6;
  border-color: #6d5bf6;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
}

.tb-result {
  border: 1rpx solid #ddd6fb;
  background: linear-gradient(135deg, #f4f2ff, #fbfaff);
}
.tb-result-label {
  font-size: 22rpx;
  color: #6f6b80;
}
.tb-result-value {
  margin-top: 8rpx;
  font-size: 56rpx;
  font-weight: 700;
  color: #211e2e;
  line-height: 1.25;
}
.tb-result-sub {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #a5a1b3;
  line-height: 1.55;
}

.tb-mini {
  background: #ffffff;
  border: 1rpx solid #eceaf2;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
}
.tb-mini-label {
  font-size: 21rpx;
  color: #6f6b80;
}
.tb-mini-value {
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #211e2e;
}
.tb-mini-sub {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #a5a1b3;
  line-height: 1.5;
}

.tb-note {
  border-radius: 20rpx;
  border: 1rpx solid #e2ddfb;
  background: #f4f2ff;
  color: #4c3fd0;
  padding: 20rpx 24rpx;
  font-size: 22rpx;
  line-height: 1.6;
}
.tb-note-warn {
  border-color: #fed7aa;
  background: #fff7ed;
  color: #9a3412;
}

.tb-progress {
  height: 20rpx;
  border-radius: 999rpx;
  background: #f1eff8;
  overflow: hidden;
}
.tb-progress-bar {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #6d5bf6, #8b5cf6);
}

.tb-orange-chip {
  background: #fff1e7;
  color: #c2410c;
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
  font-size: 21rpx;
  font-weight: 500;
}
.tb-milestone-chip {
  background: #f4f2ff;
  color: #4c3fd0;
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
  font-size: 21rpx;
}

.tb-footer {
  margin-top: 48rpx;
  text-align: center;
  font-size: 20rpx;
  color: #a5a1b3;
  line-height: 1.6;
}

.tb-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.tb-row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.tb-grid2 {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 20rpx;
}
.tb-grid2 > view {
  width: calc((100% - 20rpx) / 2);
  min-width: 0;
}
.tb-muted {
  color: #a5a1b3;
}
.tb-strong {
  font-weight: 600;
  color: #211e2e;
}

.tb-field-invalid {
  border-color: #e05252 !important;
}
.tb-grid3 {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 14rpx;
}
.tb-grid3 > view {
  width: calc((100% - 28rpx) / 3);
  min-width: 0;
}
.tb-link {
  color: #8c6d1f;
  font-size: 22rpx;
  font-weight: 500;
}
