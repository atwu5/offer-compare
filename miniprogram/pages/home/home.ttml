<view class="tb-page">
  <view class="tb-hero">
    <view class="tb-title">生活计算工具箱</view>
    <view class="tb-hero-sub">生活中的小计算，一次帮你搞定。</view>
    <view class="tb-chips">
      <view class="tb-chip">本地计算</view>
      <view class="tb-chip">无需登录</view>
      <view class="tb-chip">数据不上传</view>
    </view>
  </view>

  <view tt:if="{{nextAnniv}}" class="tb-card tb-entry" style="margin-bottom: 24rpx; padding: 24rpx;" bindtap="onOpenAnniv">
    <view class="tb-row-between">
      <view style="min-width: 0;">
        <view class="tb-strong" style="font-size: 26rpx;">💞 {{nextAnniv.name}}</view>
        <view class="tb-hint" style="margin-top: 6rpx; margin-bottom: 0;">{{nextAnniv.whenText}}</view>
      </view>
      <view class="tb-orange-chip" style="flex-shrink: 0;">{{nextAnniv.tagText}}</view>
    </view>
  </view>

  <view class="tb-grid2" style="margin-top: 0;">
    <view tt:for="{{tools}}" tt:for-item="t" tt:key="path" class="tb-card tb-entry" style="padding: 26rpx 24rpx;" bindtap="onOpenTool" data-path="{{t.path}}">
      <view class="tb-icon" style="background: {{t.tint}};">{{t.icon}}</view>
      <view class="tb-strong" style="font-size: 28rpx; margin-top: 16rpx;">{{t.name}}</view>
      <view class="tb-hint" style="margin-top: 6rpx; margin-bottom: 0;">{{t.desc}}</view>
    </view>
  </view>

  <view class="tb-footer">所有计算均在本地完成，数据不上传服务器，结果仅供参考。</view>
</view>
